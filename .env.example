# Copy to .env.local for local development. Never commit real values.

# Anthropic API key (https://console.anthropic.com). Without it the app still runs in rules-only mode.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max. "low" was fastest with comparable quality in the eval (see README).
ANTHROPIC_EFFORT=low

# Postgres connection string (Neon). On Vercel the Neon integration sets this for you; its value is
# write-only there, so copy it from the Neon console for local development.
DATABASE_URL=

# Optional spend guard for a public deployment: live model calls allowed per hour.
# Past the limit, pre-checks fall back to rules-only mode. Cached results never count.
AI_LIMIT_PER_USER_HOUR=25
AI_LIMIT_GLOBAL_HOUR=250

# Signs session cookies (required). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# Set to "false" to hide the passwordless demo personas on the landing page.
DEMO_MODE=true
