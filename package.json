{
  "name": "clearpath-compliance",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "eval": "tsx evals/run.ts",
    "seed:people": "tsx scripts/seed-people.ts",
    "seed:reference": "tsx scripts/seed-reference.ts",
    "seed:history": "tsx scripts/seed-history.ts",
    "seed:all": "npm run seed:people && npm run seed:reference && npm run seed:history && npm run seed:precedents",
    "test:smoke": "tsx scripts/smoke-workflow.ts",
    "seed:precedents": "tsx scripts/seed-precedents.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@neondatabase/serverless": "^1.2.0",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.64.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/diff": "^7.0.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
